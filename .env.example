# =============================================================================
#  Required
# =============================================================================

# FRED API key -> https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_32_char_fred_api_key

# Postgres connection used by the ETL, analytics and API layers.
# Running locally (outside Docker):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fred

# =============================================================================
#  Docker Compose only — ignored when running locally
# =============================================================================
# `docker compose up` builds DATABASE_URL from these and reaches the db by
# service name, so the value above is not used in that mode.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fred
WEB_PORT=8080

# =============================================================================
#  Optional tuning — the defaults are sensible
# =============================================================================

# Connection pool. On a hosted database that scales to zero (Neon, Supabase),
# set DB_POOL_MIN=0 so an idle dashboard does not keep the compute awake.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Ingestion. FRED allows 120 requests/minute; stay under it.
FRED_MAX_RPM=110
FRED_OBSERVATION_START=1960-01-01
INGEST_CONCURRENCY=6

# Scheduler (weekday cron, in the timezone below)
SCHEDULE_CRON_HOUR=7
SCHEDULE_CRON_MINUTE=30
SCHEDULE_TIMEZONE=America/New_York

# Shared secret for POST /api/pipeline/refresh, sent as the X-Admin-Token
# header. LEAVE THIS EMPTY on a public deployment: with no token set the
# endpoint returns 404 and the API exposes no write surface at all.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# API
API_HOST=127.0.0.1
API_PORT=8000
# Only needed when the frontend is served from a different origin than the API.
# Under Docker Compose nginx proxies /api on the same origin, so this is unused.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
